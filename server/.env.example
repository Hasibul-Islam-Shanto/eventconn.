NODE_ENV=development
LOG_LEVEL=info
# Generate two independent values with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INTERNAL_SECRET=replace-with-another-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:3000
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/auth_db
EVENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/event_db
BOOKING_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/booking_db
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/notification_db
PAYMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payment_db
AUTH_SERVICE_URL=http://localhost:4001
EVENT_SERVICE_URL=http://localhost:4002
BOOKING_SERVICE_URL=http://localhost:4003
PAYMENT_SERVICE_URL=http://localhost:4005
RABBITMQ_URL=amqp://guest:guest@localhost:5672
HOLD_MINUTES=10
# PORT is optional for a single-service process; npm run dev uses service defaults.

# SMTP Transactional Email Configuration (e.g. Gmail / Outlook / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EventConn Tickets <no-reply@eventconn.com>"
