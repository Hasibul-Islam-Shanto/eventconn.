generator client {
 provider = "prisma-client-js"
 output = "../generated/client"
}
datasource db {
 provider = "postgresql"
 url = env("EVENT_DATABASE_URL")
}
enum EventStatus {
 DRAFT
 PUBLISHED
 COMPLETED
 CANCELLED
}
model EventCategory {
 id String @id @default(uuid()) @db.Uuid
 name String @unique
 slug String @unique
 events Event[]
}
model Venue {
 id String @id @default(uuid()) @db.Uuid
 name String
 address String
 city String
 timezone String
 events Event[]
}
model Event {
 id String @id @default(uuid()) @db.Uuid
 organizerId String @db.Uuid
 title String
 slug String @unique
 shortDescription String
 description String
 coverImageUrl String?
 categoryId String @db.Uuid
 category EventCategory @relation(fields:[categoryId],references:[id])
 venueId String @db.Uuid
 venue Venue @relation(fields:[venueId],references:[id])
 startDateTime DateTime @db.Timestamptz(3)
 endDateTime DateTime @db.Timestamptz(3)
 status EventStatus @default(DRAFT)
 ticketTypes TicketType[]
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([organizerId])
 @@index([status,startDateTime])
}
model TicketType {
 id String @id @default(uuid()) @db.Uuid
 eventId String @db.Uuid
 event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
 name String
 description String @default("")
 price Int
 capacity Int
 salesStartAt DateTime @db.Timestamptz(3)
 salesEndAt DateTime @db.Timestamptz(3)
 isActive Boolean @default(true)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([eventId])
}
